# Ignore everything by default
*

# Allow specific file types
!*.cpp
!*.h
!*.py
!Makefile
!CMakeLists.txt

# Allow directories (so git can traverse them)
!*/

.*/ 

# Ignore CSV files explicitly (in case they match above patterns)
*.csv

# Common build artifacts to explicitly ignore
*.o
*.so
*.a
*.out
*.exe

# Build directories
build/
cmake-build-*/
.cmake/
.tsvc_build/
.tsvc_ext_build/
.dace_build/
.dace_ext_build/

# Markdown / LaTeX / DB outputs from vectra-plot / vectra-populate
*.db
*.db-journal

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.tsvc_build/
.tsvc_ext_build/
.dace_build/
.dace_ext_build/
vectra.db
.venv/
